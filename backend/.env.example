PROJECT_NAME="CloudAxis Enterprise Infrastructure Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cloudaxis"

# Security
SECRET_KEY="super-secret-key-change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Seeding
SEED_ON_STARTUP=true
